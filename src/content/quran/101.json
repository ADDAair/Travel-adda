[["بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","করাঘাতকারী,"],["مَا ٱلْقَارِعَةُ","করাঘাতকারী কি?"],["وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","করাঘাতকারী সম্পর্কে আপনি কি জানেন ?"],["يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"],["وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"],["فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","অতএব যার পাল্লা ভারী হবে,"],["فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","সে সুখীজীবন যাপন করবে।"],["وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","আর যার পাল্লা হালকা হবে,"],["فَأُمُّهُۥ هَاوِيَةٌ","তার ঠিকানা হবে হাবিয়া।"],["وَمَآ أَدْرَىٰكَ مَا هِيَهْ","আপনি জানেন তা কি?"],["نَارٌ حَامِيَةٌۢ","প্রজ্জ্বলিত অগ্নি!"]]