[["بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","করাঘাতকারী,","আলকারিআহ"],["مَا ٱلْقَارِعَةُ","করাঘাতকারী কি?","মাল কারিআহ"],["وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","করাঘাতকারী সম্পর্কে আপনি কি জানেন ?","ওয়ামা আদরাকা মাল কারিআহ"],["يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","ইয়াওমা ইয়াকূনুন নাসু কাল ফারাশিল মাবছূছ"],["وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","ওয়াতাকূনুল জিবালু কাল ইহনিল মানফূশ"],["فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","অতএব যার পাল্লা ভারী হবে,","ফাআম্মা মান ছাকুলাত মাওয়াযীনুহ"],["فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","সে সুখীজীবন যাপন করবে।","ফাহুওয়া ফী ঈশাতির রাদ্বিয়াহ"],["وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","আর যার পাল্লা হালকা হবে,","ওয়াআম্মা মান খাফ্ফাত মাওয়াযীনুহ"],["فَأُمُّهُۥ هَاوِيَةٌ","তার ঠিকানা হবে হাবিয়া।","ফাউম্মুহু হাউইয়াহ"],["وَمَآ أَدْرَىٰكَ مَا هِيَهْ","আপনি জানেন তা কি?","ওয়ামা আদরাকা মা হিয়াহ"],["نَارٌ حَامِيَةٌۢ","প্রজ্জ্বলিত অগ্নি!","নারুন হামিয়াহ"]]