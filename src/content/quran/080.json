[["بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","তিনি ভ্রূকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন।","আবাসা ওয়াতাওয়াল্লা"],["أَن جَآءَهُ ٱلْأَعْمَىٰ","কারণ, তাঁর কাছে এক অন্ধ আগমন করল।","আন জাআহুল আমা"],["وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","আপনি কি জানেন, সে হয়তো পরিশুদ্ধ হত,","ওয়ামা ইউদরীকা লাআল্লাহু ইয়ায্যাক্কা"],["أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","অথবা উপদেশ গ্রহণ করতো এবং উপদেশ তার উপকার হত।","আও ইয়ায্যাক্কারু ফাতানফাআহুয যিকরা"],["أَمَّا مَنِ ٱسْتَغْنَىٰ","পরন্তু যে বেপরোয়া,","আম্মা মানিসতাগনা"],["فَأَنتَ لَهُۥ تَصَدَّىٰ","আপনি তার চিন্তায় মশগুল।","ফাআনতা লাহু তাসাদ্দা"],["وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","সে শুদ্ধ না হলে আপনার কোন দোষ নেই।","ওয়ামা আলাইকা আল্লা ইয়ায্যাক্কা"],["وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","যে আপনার কাছে দৌড়ে আসলো","ওয়াআম্মা মান জাআকা ইয়াসআ"],["وَهُوَ يَخْشَىٰ","এমতাবস্থায় যে, সে ভয় করে,","ওয়াহুওয়া ইয়াখশা"],["فَأَنتَ عَنْهُ تَلَهَّىٰ","আপনি তাকে অবজ্ঞা করলেন।","ফাআনতা আনহু তালাহ্হা"],["كَلَّآ إِنَّهَا تَذْكِرَةٌ","কখনও এরূপ করবেন না, এটা উপদেশবানী।","কাল্লা ইন্নাহা তাযকিরাহ"],["فَمَن شَآءَ ذَكَرَهُۥ","অতএব, যে ইচ্ছা করবে, সে একে গ্রহণ করবে।","ফামান শাআ যাকারাহ"],["فِى صُحُفٍ مُّكَرَّمَةٍ","এটা লিখিত আছে সম্মানিত,","ফী সুহুফিম মুকার্রামাহ"],["مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","উচ্চ পবিত্র পত্রসমূহে,","ম্মারফূআতিম মুতাহ্হারাহ"],["بِأَيْدِى سَفَرَةٍ","লিপিকারের হস্তে,","বিআইদী সাফারাহ"],["كِرَامٍۭ بَرَرَةٍ","যারা মহৎ, পূত চরিত্র।","কিরামিম বারারাহ"],["قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","মানুষ ধ্বংস হোক, সে কত অকৃতজ্ঞ!","কুতিলাল ইনসানু মা আকফারাহ"],["مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","তিনি তাকে কি বস্তু থেকে সৃষ্টি করেছেন?","মিন আইয়্যি শাইয়িন খালাকাহ"],["مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","শুক্র থেকে তাকে সৃষ্টি করেছেন, অতঃপর তাকে সুপরিমিত করেছেন।","মিন নুতফাতিন খালাকাহু ফাকাদ্দারাহ"],["ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","অতঃপর তার পথ সহজ করেছেন,","ছুম্মাস সাবীলা ইয়াস্সারাহ"],["ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","অতঃপর তার মৃত্যু ঘটান ও কবরস্থ করেন তাকে।","ছুম্মা আমাতাহু ফাআকবারাহ"],["ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","এরপর যখন ইচ্ছা করবেন তখন তাকে পুনরুজ্জীবিত করবেন।","ছুম্মা ইযা শাআ আনশারাহ"],["كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","সে কখনও কৃতজ্ঞ হয়নি, তিনি তাকে যা আদেশ করেছেন, সে তা পূর্ণ করেনি।","কাল্লা লাম্মা ইয়াকদ্বি মা আমারাহ"],["فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","মানুষ তার খাদ্যের প্রতি লক্ষ্য করুক,","ফালইয়ানযুরিল ইনসানু ইলা তাআমিহ"],["أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","আমি আশ্চর্য উপায়ে পানি বর্ষণ করেছি,","আন্না সাবাবনাল মাআ সাব্বা"],["ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","এরপর আমি ভূমিকে বিদীর্ণ করেছি,","ছুম্মা শাকাকনাল আরদ্বা শাক্কা"],["فَأَنۢبَتْنَا فِيهَا حَبًّا","অতঃপর তাতে উৎপন্ন করেছি শস্য,","ফাআনবাতনা ফীহা হাব্বা"],["وَعِنَبًا وَقَضْبًا","আঙ্গুর, শাক-সব্জি,","ওয়াইনাবান ওয়াকাদ্ববা"],["وَزَيْتُونًا وَنَخْلًا","যয়তুন, খর্জূর,","ওয়াযাইতূনান ওয়ানাখলা"],["وَحَدَآئِقَ غُلْبًا","ঘন উদ্যান,","ওয়াহাদাইকা গুলবা"],["وَفَـٰكِهَةً وَأَبًّا","ফল এবং ঘাস","ওয়াফাকিহাতান ওয়াআব্বা"],["مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","তোমাদেরও তোমাদের চতুস্পদ জন্তুদের উপাকারার্থে।","ম্মাতাআল লাকুম ওয়ালিআনআমিকুম"],["فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","অতঃপর যেদিন কর্ণবিদারক নাদ আসবে,","ফাইযা জাআতিস সাখ্খাহ"],["يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","সেদিন পলায়ন করবে মানুষ তার ভ্রাতার কাছ থেকে,","ইয়াওমা ইয়াফির্রুল মারউ মিন আখীহ"],["وَأُمِّهِۦ وَأَبِيهِ","তার মাতা, তার পিতা,","ওয়াউম্মিহি ওয়াআবীহ"],["وَصَـٰحِبَتِهِۦ وَبَنِيهِ","তার পত্নী ও তার সন্তানদের কাছ থেকে।","ওয়াসাহিবাতিহি ওয়াবানীহ"],["لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","সেদিন প্রত্যেকেরই নিজের এক চিন্তা থাকবে, যা তাকে ব্যতিব্যস্ত করে রাখবে।","লিকুল্লিমরিইম মিনহুম ইয়াওমাইযিন শানুন ইউগনীহ"],["وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","অনেক মুখমন্ডল সেদিন হবে উজ্জ্বল,","উজূহুন ইয়াওমাইযিম মুসফিরাহ"],["ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","সহাস্য ও প্রফুল্ল।","দ্বাহিকাতুম মুসতাবশিরাহ"],["وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","এবং অনেক মুখমন্ডল সেদিন হবে ধুলি ধূসরিত।","ওয়াউজূহুন ইয়াওমাইযিন আলাইহা গাবারাহ"],["تَرْهَقُهَا قَتَرَةٌ","তাদেরকে কালিমা আচ্ছন্ন করে রাখবে।","তারহাকুহা কাতারাহ"],["أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","তারাই কাফের পাপিষ্ঠের দল।","ঊলাইকা হুমুল কাফারাতুল ফাজারাহ"]]