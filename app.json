{
  "expo": {
    "name": "Travel Adda",
    "slug": "travel-adda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.traveladda.hajumrah",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001952"
      }
    },
    "ios": {
      "bundleIdentifier": "app.traveladda.hajumrah"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "প্রোফাইল ছবি এবং পাসপোর্ট-ভিসার মতো কাগজের ছবি তোলার জন্য ক্যামেরা লাগবে। ছবি শুধু আপনি নিজে তুললেই নেওয়া হয়।",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "নামাজের সময় ও কিবলার দিক বের করতে আপনার অবস্থান লাগবে। অবস্থান শুধু ফোনেই থাকে।",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "owner": "traveladda",
    "extra": {
      "eas": {
        "projectId": "c1ded2f5-ed4f-4ffd-b39d-343a59272e1b"
      }
    },
    "icon": "./assets/icon.png",
    "primaryColor": "#001952"
  }
}
